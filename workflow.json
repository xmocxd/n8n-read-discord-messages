    {
      "parameters": {
        "jsCode": "// 1. Get the data coming directly into this node\nconst inputItems = $input.all();\n\n// 2. Safely get your User ID \nlet targetUserId = \"\";\ntry {\n  targetUserId = $(\"Set User Info\").first().json.myUserId; \n} catch (e) {\n  throw new Error(\"Could not find node named 'Set User Info'. Check the name of your first node!\");\n}\n\n// 3. Filter the messages\nconst myMessages = inputItems.filter(i => i.json.author && i.json.author.id === targetUserId);\n\n// 4. Find the oldest ID for the next loop\nconst oldestId = inputItems.length > 0 ? inputItems[inputItems.length - 1].json.id : null;\n\n// 5. Return the result with attachment support\nreturn {\n  myMessages: myMessages.map(m => {\n    // Extract attachment URLs and join them with a comma and space\n    const attachmentLinks = m.json.attachments && m.json.attachments.length > 0\n      ? m.json.attachments.map(a => a.url).join(', ')\n      : \"\";\n\n    return { \n      id: m.json.id,\n      content: m.json.content, \n      timestamp: m.json.timestamp,\n      attachments: attachmentLinks\n    };\n  }),\n  oldestId: oldestId,\n  hasMore: inputItems.length === 100 \n};"
      },
