    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        body { font-family: sans-serif; display: flex; justify-content: center; padding-top: 50px; background: #f4f7f6; }\n        form { background: white; padding: 25px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 300px; }\n        select, button { width: 100%; padding: 10px; margin-top: 10px; border-radius: 4px; border: 1px solid #ccc; }\n        button { background: #007bff; color: white; border: none; cursor: pointer; }\n        button:hover { background: #0056b3; }\n    </style>\n</head>\n<body>\n    <form id=\"discordForm\">\n        <h3>Select Channel</h3>\n        <select id=\"channel\" name=\"channel_id\"></select>\n        <button id=\"submitBtn\" type=\"submit\">Go</button>\n        <div id=\"status\"></div>\n    </form>\n    \n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const data = {{ JSON.stringify($input.all().map(i => i.json)) }};\n            const select = document.getElementById('channel');\n            \n            data.forEach(c => {\n                let opt = document.createElement('option');\n                opt.value = c.id;\n                opt.textContent = c.name;\n                select.appendChild(opt);\n            });\n            \n            document.getElementById('discordForm').addEventListener('submit', function(event) {\n                event.preventDefault(); // THIS IS CRITICAL\n            });\n            \n            document.getElementById('submitBtn').addEventListener('click', async () => {\n                const channelId = document.getElementById('channel').value;\n                const statusDiv = document.getElementById('status');\n                \n                try {\n                    statusDiv.textContent = \"Sending...\";\n                    const response = await fetch(\"https://example.app.n8n.cloud/webhook/00000000-0000-0000-0000-000000000000\", {\n                        method: 'POST',\n                        headers: { 'Content-Type': 'application/json' },\n                        body: JSON.stringify({ channel_id: channelId })\n                    });\n                    \n                    if (response.ok) {\n                        statusDiv.textContent = \"Success! Message sent to Discord.\";\n                    } else {\n                        statusDiv.textContent = \"Error sending message.\";\n                    }\n                } catch (err) {\n                    statusDiv.textContent = \"Network error occurred.\";\n                }\n            });\n        });\n    </script> \n</body>\n</html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
